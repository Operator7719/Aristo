      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "teacherCode": { "type": "string", "minLength": 1, "maxLength": 60 },
        "name": { "type": "string", "minLength": 1, "maxLength": 150 },
        "email": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 60 },
        "qualification": { "type": "string", "maxLength": 150 },
        "specialization": { "type": "string", "maxLength": 150 },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "joinedDate": { "type": "string", "maxLength": 40 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "teacherCode",
        "name",
        "email",
        "phone",
        "qualification",
        "specialization",
        "status",
        "joinedDate",
        "ownerUid",
        "ownerEmail",
        "createdAt",
        "updatedAt"
      ]
    },
    "TeacherAssignmentDoc": {
      "title": "TeacherAssignmentDoc",
      "description": "Subject teacher assignment for class, section, and academic year.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "academicYearId": { "type": "string", "minLength": 1, "maxLength": 40 },
        "teacherId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "classId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sectionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "subjectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "assignmentType": { "type": "string", "enum": ["class_teacher", "subject_teacher"] },
        "periodSlot": { "type": "string", "maxLength": 80 },
        "createdBy": { "type": "string", "maxLength": 80 },
        "createdDate": { "type": "string", "maxLength": 40 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "academicYearId",
        "teacherId",
        "classId",
        "sectionId",
        "subjectId",
        "assignmentType",
        "createdBy",
        "createdDate",
        "ownerUid",
        "ownerEmail",
        "createdAt",
        "updatedAt"
      ]
    },
    "TeacherPassportDoc": {
      "title": "TeacherPassportDoc",
      "description": "Hashed teacher login credential and assignment metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "passportNumber": { "type": "string", "minLength": 1, "maxLength": 80 },
        "passportTitle": { "type": "string", "minLength": 1, "maxLength": 120 },
        "username": { "type": "string", "minLength": 1, "maxLength": 80 },
        "passcode": { "type": "string", "maxLength": 128 },
        "passwordHash": { "type": "string", "maxLength": 256 },
        "passwordSalt": { "type": "string", "maxLength": 128 },
        "passwordUpdatedDate": { "type": "string", "maxLength": 40 },
        "passwordUpdatedBy": { "type": "string", "maxLength": 80 },
        "assignedTeacherId": { "type": "string", "maxLength": 128 },
        "issuedDate": { "type": "string", "maxLength": 40 },
        "expiryDate": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["active", "revoked", "expired"] },
        "notes": { "type": "string", "maxLength": 300 },
        "createdBy": { "type": "string", "maxLength": 80 },
        "createdDate": { "type": "string", "maxLength": 40 },
        "assignedDate": { "type": "string", "maxLength": 40 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "passportNumber",
        "passportTitle",
        "username",
        "passcode",
        "issuedDate",
        "expiryDate",
        "status",
        "createdBy",
        "createdDate",
        "ownerUid",
        "ownerEmail",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Single authorized administrator registry document."
    },
    "/school_settings/{settingId}": {
      "schema": { "$ref": "#/entities/SchoolSettingsDoc" },
      "description": "School profile, signatories, grading rules, and academic year list."
    },
    "/admin_security/{docId}": {
      "schema": { "$ref": "#/entities/AdminSecurityDoc" },
      "description": "Salted admin password hash and security policy configuration."
    },
    "/school_classes/{classId}": {
      "schema": { "$ref": "#/entities/SchoolClassDoc" },
      "description": "Class levels and section lists."
    },
    "/subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/SubjectDoc" },
      "description": "Subjects mapped to each school class."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/StudentDoc" },
      "description": "Student roster and optional subject selections."
    },
    "/exams/{examId}": {
      "schema": { "$ref": "#/entities/ExamDoc" },
      "description": "Terminal and annual exams."
    },
    "/marks/{markId}": {
      "schema": { "$ref": "#/entities/MarkRecordDoc" },
      "description": "Exam marks and attendance records."
    },
    "/teachers/{teacherId}": {
      "schema": { "$ref": "#/entities/TeacherDoc" },
      "description": "Faculty directory records."
    },
    "/teacher_subject_assignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/TeacherAssignmentDoc" },
      "description": "Subject teacher assignments."
    },
    "/teacher_passports/{passportId}": {
      "schema": { "$ref": "#/entities/TeacherPassportDoc" },
      "description": "Hashed teacher login credentials."
    }
  }
}
